//lib : ts가 어디서 동작할지 정의(어느 파일에서 어떻게 동작하는지) [웹에서 사용 => DOM : document, window객체 사용가능]
//strict : 엄격한 타입체크 (라이브러리에서 타입을 가져올때 ts에서 원활하게 작동하는지 확인하거나, 타입을 엄격하게 적용할때 사용)
//typeRoots : 타입정의 파일을 가져올때 어디서 가져올지 정의 (src/package에서 가져올것이다)
//allowJs : ts가 함수 타입을 추론하여 가져올수 있게 해주는 옵션
//esModuleInterop : 모듈을 가져올때 es6의 모듈 시스템을 사용할수 있게 해주는 옵션
//module : 모듈 시스템을 어떻게 사용할지 정의 (CommonJS : node.js에서 사용하는 모듈 시스템)

{
  "include": ["src"],
  "compilerOptions": {
    "outDir": "build",
    "target": "ES6",
    "esModuleInterop": true,
    "lib": ["ES6"],
    "strict": true,
    "typeRoots": ["./src/package", "./node_modules/@types"],
    "module" : "CommonJS"
  }
}
